# Neon Serverless Postgres
# Gunakan pooled connection string untuk runtime Vercel Serverless:
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require"

# Gunakan direct connection string untuk menjalankan migrasi prisma (prisma migrate):
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].[REGION].aws.neon.tech/neondb?sslmode=require"

# NextAuth.js (Auth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-dengan-openssl-rand-base64-32-atau-string-acak-panjang"

# Vercel Blob Storage Token (disediakan otomatis oleh Vercel dashboard saat Blob dihubungkan)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"

